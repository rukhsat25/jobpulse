# Databricks (fill in once your Free Edition workspace is created)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Databricks Unity Catalog — raw landing zone (Stage 3)
# If CREATE CATALOG worked for you: jobpulse / raw_landing / landing
# If you fell back to the default catalog: workspace / jobpulse_raw_landing / landing
DATABRICKS_CATALOG=jobpulse
DATABRICKS_SCHEMA=raw_landing
DATABRICKS_VOLUME=landing

# Ingestion
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=4

# App
LOG_LEVEL=INFO
